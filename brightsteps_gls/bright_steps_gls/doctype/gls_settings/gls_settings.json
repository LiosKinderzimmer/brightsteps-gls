    {"fieldname":"group_same_address","label":"Lieferscheine gleicher Adresse und desselben Tages zusammenfassen","fieldtype":"Check","default":"1"},
    {"fieldname":"test_email","label":"Interne Test-E-Mail","fieldtype":"Data","options":"Email"},
